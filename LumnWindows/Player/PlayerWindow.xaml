<Window x:Class="LumnWindows.Player.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="740" Height="580"
        MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Title="Lumn Player">

    <Border x:Name="WindowRoot"
            Background="#161616"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            CornerRadius="16"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>  <!-- Top Windows Title Bar -->
                <RowDefinition Height="*"/>   <!-- Main Content (Player) -->
                <RowDefinition Height="Auto"/> <!-- Bottom Toolbar -->
            </Grid.RowDefinitions>

            <!-- 1. WINDOWS TITLE BAR (Title on Left, Windows Caption Buttons on Right) -->
            <Grid Grid.Row="0">
                <!-- App Icon & Title on Left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="🎵" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Lumn" FontWeight="Bold" FontSize="13" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusIndicatorText" Text=" • Ready" Foreground="#888888" FontSize="12" Margin="6,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>

                <!-- Top Right: Media Source Badge + Windows Caption Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <!-- Media Source Badge (Green) -->
                    <Border x:Name="MediaSourceBadge"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            Background="#182E1E" BorderBrush="#1DB954" BorderThickness="1"
                            CornerRadius="10" Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#1DB954" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLabel" Text="Spotify &amp; Windows Media" Foreground="#1DB954" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Windows Minimize Button (─) -->
                    <Button x:Name="WinMinBtn" Style="{StaticResource WindowsCaptionBtn}"
                            Content="─" ToolTip="Minimize to Taskbar"
                            Click="MinimizeButton_Click"/>

                    <!-- Windows Close Button (✕) -> Closes to Tray -->
                    <Button x:Name="WinCloseBtn" Style="{StaticResource WindowsCloseCaptionBtn}"
                            Content="✕" ToolTip="Close to System Tray"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. MAIN CONTENT AREA -->
            <Grid Grid.Row="1" Margin="16,4,16,8">
                <!-- COMPACT MEDIA PLAYER VIEW (Always Ready, Zero Setup) -->
                <Grid x:Name="CompactPlayerView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Status Warning Banner -->
                        <RowDefinition Height="*"/>    <!-- Artwork / Synced Lyrics -->
                        <RowDefinition Height="Auto"/> <!-- Song Title + Artist -->
                        <RowDefinition Height="Auto"/> <!-- Real-time Progress Bar & Seek -->
                        <RowDefinition Height="Auto"/> <!-- Playback Controls Pill -->
                        <RowDefinition Height="Auto"/> <!-- Lyrics Toggle Pill -->
                    </Grid.RowDefinitions>

                    <!-- Status Warning Banner -->
                    <Border Grid.Row="0" x:Name="StatusBanner" Visibility="Collapsed"
                            Background="#332505" BorderBrush="#66480B" BorderThickness="1"
                            CornerRadius="8" Padding="12,6" Margin="0,0,0,8">
                        <TextBlock x:Name="StatusBannerText" Text="Ready"
                                   Foreground="#FFD54F" FontSize="12" TextAlignment="Center"/>
                    </Border>

                    <!-- Large Album Art Container / Synced Lyrics View -->
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <!-- Centered Rounded Album Artwork -->
                        <Border x:Name="ArtworkBorder"
                                Width="220" Height="220"
                                CornerRadius="14"
                                Background="#202020"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <!-- Default Placeholder Graphic -->
                                <Border Background="#1C1C1C">
                                    <TextBlock Text="🎵" FontSize="44" Foreground="#383838"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Album Art Image -->
                                <Image x:Name="AlbumArtImage" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Expandable Synced Lyrics Overlay (Frosted glass scrollable panel) -->
                        <Border x:Name="LyricsPanel"
                                Width="490" Height="230"
                                CornerRadius="14"
                                Background="#1C1C1C"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Padding="20,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Synced Lyrics" FontWeight="Bold" FontSize="14" Foreground="#00E5FF"/>
                                    <TextBlock x:Name="LyricsStatusText" Text="" FontSize="11" Foreground="#777777"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" x:Name="LyricsScrollViewer"
                                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="LyricsLinesContainer" HorizontalAlignment="Center" Margin="0,40,0,40"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Song Title + Artist -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,6">
                        <TextBlock x:Name="TrackTitleText" Text="Waiting for Music..."
                                   FontSize="17" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                        <TextBlock x:Name="TrackArtistText" Text="Play any song in Spotify Desktop, YouTube, or browser"
                                   FontSize="13" Foreground="#888888"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                    </StackPanel>

                    <!-- Real-Time Progress Bar (0:42 / 3:21 with seek on click/drag) -->
                    <Grid Grid.Row="3" Width="420" HorizontalAlignment="Center" Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ProgressTimeText" Grid.Column="0" Text="0:00"
                                   Foreground="#777777" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                        <Slider x:Name="TrackProgressSlider" Grid.Column="1"
                                Minimum="0" Maximum="100" Value="0"
                                Height="24" Margin="8,0" VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                                PreviewMouseUp="ProgressSlider_PreviewMouseUp"
                                ValueChanged="ProgressSlider_ValueChanged"/>

                        <TextBlock x:Name="DurationTimeText" Grid.Column="2" Text="0:00"
                                   Foreground="#777777" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Playback Controls Pill [⏮10, ⏮, ▶/⏸, ⏭, 10⏭] -->
                    <Border Grid.Row="4"
                            Background="#222222"
                            CornerRadius="24"
                            Padding="8,4"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Replay 10s -->
                            <Button Style="{StaticResource RoundIconButton}" Content="⏮10" FontSize="11" FontWeight="Bold"
                                    ToolTip="Replay 10s" Click="SkipBack10_Click"/>
                            <!-- Prev -->
                            <Button Style="{StaticResource RoundIconButton}" Content="⏮"
                                    ToolTip="Previous Track" Click="PreviousTrack_Click"/>
                            <!-- Play / Pause -->
                            <Button x:Name="PlayPauseBtn" Style="{StaticResource PlayPauseButton}"
                                    Content="▶" ToolTip="Play / Pause" Click="PlayPause_Click"/>
                            <!-- Next -->
                            <Button Style="{StaticResource RoundIconButton}" Content="⏭"
                                    ToolTip="Next Track" Click="NextTrack_Click"/>
                            <!-- Skip 10s -->
                            <Button Style="{StaticResource RoundIconButton}" Content="10⏭" FontSize="11" FontWeight="Bold"
                                    ToolTip="Skip 10s" Click="SkipForward10_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Lyrics Toggle Pill -->
                    <Button Grid.Row="5" x:Name="LyricsToggleBtn" Style="{StaticResource LyricsPillButton}"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Content="💬 Lyrics" Click="LyricsToggle_Click"/>
                </Grid>
            </Grid>

            <!-- 3. BOTTOM TOOLBAR (Palette, Beat Sync, Brightness, Settings, Monitor) -->
            <Border Grid.Row="2"
                    Background="#111111"
                    BorderBrush="#242424"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="14,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 🎨 Palette -->
                        <Button x:Name="PaletteBtn" Style="{StaticResource ToolbarIconButton}"
                                ToolTip="Color Palette &amp; Override" Click="Palette_Click">
                            <TextBlock Text="🎨" FontSize="15" VerticalAlignment="Center"/>
                        </Button>

                        <!-- 〰 Waveform / Beat Sync Toggle -->
                        <Button x:Name="WaveformBtn" Style="{StaticResource ToolbarIconButton}"
                                ToolTip="Toggle Beat Sync" Click="Waveform_Click">
                            <TextBlock x:Name="WaveformIcon" Text="〰" FontSize="18" Foreground="#00E5FF" VerticalAlignment="Center"/>
                        </Button>

                        <!-- 💡 Brightness (Expands inline to show slider) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BulbBtn" Style="{StaticResource ToolbarIconButton}"
                                    ToolTip="Edge Brightness" Click="Bulb_Click">
                                <TextBlock Text="💡" FontSize="15" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Inline Expandable Slider [- ▬▬▬ +] -->
                            <StackPanel x:Name="InlineBrightnessPanel" Orientation="Horizontal"
                                        VerticalAlignment="Center" Visibility="Collapsed" Margin="2,0,8,0">
                                <TextBlock Text="−" Foreground="#777777" FontSize="14" VerticalAlignment="Center" Margin="2,0"/>
                                <Slider x:Name="InlineBrightnessSlider" Minimum="0" Maximum="100" Value="80"
                                        Width="100" VerticalAlignment="Center" ValueChanged="InlineBrightness_ValueChanged"/>
                                <TextBlock Text="+" Foreground="#777777" FontSize="14" VerticalAlignment="Center" Margin="2,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Settings Button -->
                        <Button x:Name="SettingsBtn" Style="{StaticResource ToolbarTextButton}"
                                Content="Settings" ToolTip="Open Lumn Settings" Click="Settings_Click"/>

                        <!-- 🖥 Monitor Selector -->
                        <Button x:Name="DisplayBtn" Style="{StaticResource ToolbarIconButton}"
                                ToolTip="Display Mode" Click="Display_Click">
                            <TextBlock Text="🖥" FontSize="14" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
