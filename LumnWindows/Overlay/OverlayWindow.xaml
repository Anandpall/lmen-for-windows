<Window x:Class="LumnWindows.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LumnWindows Overlay"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Left="0" Top="0"
        Width="1920" Height="1080">
    <Grid x:Name="RootGrid" Background="Transparent" ClipToBounds="False">
        <!-- TOP EDGE GLOW -->
        <Rectangle x:Name="TopEdge" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                   Height="60" Margin="-50,-50,-50,0">
            <Rectangle.Effect>
                <BlurEffect x:Name="TopBlur" Radius="75" RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- BOTTOM EDGE GLOW -->
        <Rectangle x:Name="BottomEdge" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                   Height="60" Margin="-50,0,-50,-50">
            <Rectangle.Effect>
                <BlurEffect x:Name="BottomBlur" Radius="75" RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- LEFT EDGE GLOW -->
        <Rectangle x:Name="LeftEdge" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Width="60" Margin="-50,-50,0,-50">
            <Rectangle.Effect>
                <BlurEffect x:Name="LeftBlur" Radius="75" RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- RIGHT EDGE GLOW -->
        <Rectangle x:Name="RightEdge" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Width="60" Margin="0,-50,-50,-50">
            <Rectangle.Effect>
                <BlurEffect x:Name="RightBlur" Radius="75" RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>
    </Grid>
</Window>
