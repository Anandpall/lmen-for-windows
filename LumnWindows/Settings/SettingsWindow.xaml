<Window x:Class="LumnWindows.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumn Control Center — Edge Lighting"
        Width="500" Height="820"
        Background="#0F0F14"
        Foreground="White"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Dark card style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="BorderBrush" Value="#2A2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Slider style -->
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
        </Style>

        <!-- Section heading styles -->
        <Style x:Key="CyanHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00C8FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="GreenHeading" TargetType="TextBlock" BasedOn="{StaticResource CyanHeading}">
            <Setter Property="Foreground" Value="#00FF88"/>
        </Style>
        <Style x:Key="PinkHeading" TargetType="TextBlock" BasedOn="{StaticResource CyanHeading}">
            <Setter Property="Foreground" Value="#FF1493"/>
        </Style>
        <Style x:Key="DescText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Scrollable content -->
            <RowDefinition Height="Auto"/>  <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Lumn Control Center" FontSize="22" FontWeight="Bold" Foreground="#00C8FF"/>
                <TextBlock Text="Ambient Edge Lighting &amp; Full Spectral Sync (v2)" FontSize="11" Foreground="#888899" Margin="0,2,0,0"/>
            </StackPanel>

            <CheckBox x:Name="ChkEnabled" Grid.Column="1" Content="Lighting Active" FontWeight="Bold" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
            <Button Grid.Column="2" Content="✕ Quit Lumn" Background="#8B0000" Foreground="White" BorderThickness="0" Padding="12,6" FontWeight="Bold" FontSize="12" Click="OnQuitClicked" ToolTip="Completely close LumnWindows"/>
        </Grid>

        <!-- ===== SCROLLABLE SETTINGS ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0" Padding="0,0,6,0">
            <StackPanel>

                <!-- NOW PLAYING CARD -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Track info -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#2A2A3A" HorizontalAlignment="Left">
                                <Image x:Name="AlbumArtImage" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock x:Name="TxtTrackTitle" Text="Waiting for YouTube Music..." FontWeight="SemiBold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtTrackArtist" Text="Launch Chrome with CDP or start playback" Foreground="#888899" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Live palette dots -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotPalette1" Width="20" Height="20" Margin="3,0" Fill="#00C8FF" ToolTip="Primary Color"/>
                                <Ellipse x:Name="DotPalette2" Width="20" Height="20" Margin="3,0" Fill="#B400FF" ToolTip="Secondary Color"/>
                                <Ellipse x:Name="DotPalette3" Width="20" Height="20" Margin="3,0" Fill="#FF0078" ToolTip="Accent Color"/>
                            </StackPanel>
                        </Grid>

                        <!-- Chrome CDP Status & Launch button -->
                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="#252535" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="DotCdpStatus" Width="9" Height="9" Fill="#888899" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtCdpStatus" Text="Chrome CDP: Disconnected" FontSize="11" Foreground="#888899"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Launch Chrome for YTM" Click="OnLaunchChromeClicked" Background="#2A2A3A" Foreground="#00C8FF" BorderThickness="0" Padding="10,4" FontSize="11" FontWeight="SemiBold" ToolTip="Opens Chrome with debugging enabled for YouTube Music"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- EDGE LIGHTING WIDTH & SIZE -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Edge Lighting Width &amp; Size" Style="{StaticResource CyanHeading}"/>

                        <Grid>
                            <TextBlock Text="Edge Thickness (Width)" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblThickness" Text="34 px" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#00C8FF"/>
                        </Grid>
                        <Slider x:Name="SldThickness" Minimum="2" Maximum="140" Value="34" ValueChanged="OnSliderChanged"/>
                        <TextBlock Style="{StaticResource DescText}" Text="Controls how wide the physical glow is along your screen borders (2px hairline to 140px band)."/>

                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Aura Diffusion / Bloom Spread" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblSpread" Text="1.4x" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#00C8FF"/>
                        </Grid>
                        <Slider x:Name="SldSpread" Minimum="1.0" Maximum="3.0" Value="1.4" SmallChange="0.1" ValueChanged="OnSliderChanged"/>

                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Master Opacity / Brightness" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblOpacity" Text="85%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#00C8FF"/>
                        </Grid>
                        <Slider x:Name="SldOpacity" Minimum="0" Maximum="100" Value="85" SmallChange="5" ValueChanged="OnSliderChanged"/>
                    </StackPanel>
                </Border>

                <!-- REVOLVING MOTION -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Revolving Motion Around Screen" Style="{StaticResource GreenHeading}"/>

                        <CheckBox x:Name="ChkRevolve" Content="Revolve Lighting &amp; Colors Around Screen Perimeter" IsChecked="True" FontWeight="SemiBold" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                        <TextBlock Style="{StaticResource DescText}" Text="Continuously circulates album art color gradients and liquid light waves around the edges."/>

                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="Perimeter Rotation Speed" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblRotationSpeed" Text="1.6x" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#00FF88"/>
                        </Grid>
                        <Slider x:Name="SldRotationSpeed" Minimum="0.1" Maximum="5.0" Value="1.6" SmallChange="0.1" ValueChanged="OnSliderChanged"/>
                    </StackPanel>
                </Border>

                <!-- BEAT SYNC (SPECTRAL FLUX) -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Beat Synchronization (Spectral Flux)" Style="{StaticResource PinkHeading}"/>
                            <!-- Live beat indicator dot -->
                            <Ellipse x:Name="BeatDot" Width="14" Height="14" Fill="#FF1493" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.3" ToolTip="Pulses on beat transient"/>
                        </Grid>

                        <CheckBox x:Name="ChkBeatSync" Content="Enable Full Spectral Sync" IsChecked="True" FontWeight="SemiBold" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>

                        <!-- 6-band spectrum visualiser bars (mini, live) -->
                        <Grid Margin="0,10,0,4" Height="48" Background="#12121A">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="BarSubBass" Background="#FF1493" VerticalAlignment="Bottom" Height="4" Margin="3,0"/>
                            <Border Grid.Column="1" x:Name="BarBass" Background="#FF4466" VerticalAlignment="Bottom" Height="4" Margin="3,0"/>
                            <Border Grid.Column="2" x:Name="BarLowMid" Background="#FF8800" VerticalAlignment="Bottom" Height="4" Margin="3,0"/>
                            <Border Grid.Column="3" x:Name="BarMid" Background="#FFDD00" VerticalAlignment="Bottom" Height="4" Margin="3,0"/>
                            <Border Grid.Column="4" x:Name="BarUpperMid" Background="#00FF88" VerticalAlignment="Bottom" Height="4" Margin="3,0"/>
                            <Border Grid.Column="5" x:Name="BarAir" Background="#00C8FF" VerticalAlignment="Bottom" Height="4" Margin="3,0"/>
                        </Grid>

                        <!-- Band labels -->
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sub" Style="{StaticResource DescText}" TextAlignment="Center" Margin="0"/>
                            <TextBlock Grid.Column="1" Text="Bass" Style="{StaticResource DescText}" TextAlignment="Center" Margin="0"/>
                            <TextBlock Grid.Column="2" Text="Lo-Mid" Style="{StaticResource DescText}" TextAlignment="Center" Margin="0"/>
                            <TextBlock Grid.Column="3" Text="Mid" Style="{StaticResource DescText}" TextAlignment="Center" Margin="0"/>
                            <TextBlock Grid.Column="4" Text="Hi-Mid" Style="{StaticResource DescText}" TextAlignment="Center" Margin="0"/>
                            <TextBlock Grid.Column="5" Text="Air" Style="{StaticResource DescText}" TextAlignment="Center" Margin="0"/>
                        </Grid>

                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="Beat Sensitivity" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblBeatSensitivity" Text="1.0x" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF1493"/>
                        </Grid>
                        <Slider x:Name="SldBeatSensitivity" Minimum="0.5" Maximum="3.0" Value="1.0" SmallChange="0.1" ValueChanged="OnSliderChanged"/>

                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Release / Decay Speed" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblDecaySpeed" Text="0.5x" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF1493"/>
                        </Grid>
                        <Slider x:Name="SldDecaySpeed" Minimum="0.1" Maximum="1.0" Value="0.5" SmallChange="0.05" ValueChanged="OnSliderChanged"/>
                        <TextBlock Style="{StaticResource DescText}" Text="Higher = faster fade between beats. Lower = lingering afterglow."/>
                    </StackPanel>
                </Border>

                <!-- COLOR MODE -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Color Source" Style="{StaticResource CyanHeading}"/>
                        <ComboBox x:Name="CmbColorMode" Background="#2A2A3A" Foreground="#0F0F14" SelectionChanged="OnColorModeChanged" Margin="0,0,0,8">
                            <ComboBoxItem Content="Album Art (Live extracted from YTM thumbnail)" Tag="AlbumArt" IsSelected="True"/>
                            <ComboBoxItem Content="Static Color" Tag="Static"/>
                            <ComboBoxItem Content="Rainbow / Hue Cycle" Tag="Rainbow"/>
                        </ComboBox>

                        <StackPanel x:Name="PnlStaticColor" Visibility="Collapsed" Margin="0,0,0,4">
                            <TextBlock Text="Static Color Hex (#RRGGBB)" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtStaticHex" Text="#00C8FF" Background="#2A2A3A" Foreground="White" BorderBrush="#00C8FF" Padding="6" TextChanged="OnStaticHexChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- STARTUP -->
                <Border Style="{StaticResource CardStyle}">
                    <CheckBox x:Name="ChkStartWithWindows" Content="Start with Windows" Checked="OnLiveSettingChanged" Unchecked="OnLiveSettingChanged"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== FOOTER BUTTONS ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="✕ Quit Lumn" Background="#8B0000" Foreground="White" BorderThickness="0" Padding="14,8" FontWeight="Bold" Click="OnQuitClicked"/>
            <Button Grid.Column="2" Content="Reset Defaults" Background="Transparent" Foreground="White" BorderBrush="#3A3A4A" BorderThickness="1" Padding="14,8" Margin="0,0,8,0" Click="OnResetClicked"/>
            <Button Grid.Column="3" Content="Save Settings" Background="#1A5FCC" Foreground="White" BorderThickness="0" Padding="16,8" FontWeight="Bold" Click="OnSaveClicked"/>
        </Grid>
    </Grid>
</Window>
