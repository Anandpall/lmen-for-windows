<Window x:Class="LumnWindows.Settings.SettingsPopover"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="320"
        SizeToContent="Height"
        WindowStartupLocation="Manual">

    <Border Background="#222222"
            BorderBrush="#383838"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Title Bar -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Lumn" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Foreground="#888888" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <!-- Gradient Selector -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gradient" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13"/>
                <ComboBox x:Name="GradientCombo" Grid.Column="1" Width="120"
                          Background="#333333" Foreground="White"
                          SelectionChanged="GradientCombo_SelectionChanged">
                    <ComboBoxItem Content="2 Colors"/>
                    <ComboBoxItem Content="3 Colors"/>
                    <ComboBoxItem Content="Rainbow"/>
                </ComboBox>
            </Grid>

            <!-- Animation Selector -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Animation" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13"/>
                <ComboBox x:Name="AnimationCombo" Grid.Column="1" Width="120"
                          Background="#333333" Foreground="White"
                          SelectionChanged="AnimationCombo_SelectionChanged">
                    <ComboBoxItem Content="Music Sync"/>
                    <ComboBoxItem Content="Static"/>
                    <ComboBoxItem Content="Breathing"/>
                    <ComboBoxItem Content="Off"/>
                </ComboBox>
            </Grid>

            <Separator Background="#3A3A3A" Margin="0,4,0,10"/>

            <!-- Thickness Slider -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Thickness" Foreground="#AAAAAA" FontSize="12"/>
                <TextBlock x:Name="ThicknessText" Text="28 px" Foreground="#CCCCCC" HorizontalAlignment="Right" FontSize="12"/>
            </Grid>
            <Slider x:Name="ThicknessSlider" Minimum="2" Maximum="80" Value="28"
                    ValueChanged="ThicknessSlider_ValueChanged" Margin="0,0,0,10"/>

            <!-- Glow Slider -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Glow" Foreground="#AAAAAA" FontSize="12"/>
                <TextBlock x:Name="GlowText" Text="2.0x" Foreground="#CCCCCC" HorizontalAlignment="Right" FontSize="12"/>
            </Grid>
            <Slider x:Name="GlowSlider" Minimum="1.0" Maximum="4.0" Value="2.0"
                    ValueChanged="GlowSlider_ValueChanged" Margin="0,0,0,10"/>

            <!-- Revolve Perimeter Motion -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Revolve perimeter" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
                <ToggleButton x:Name="RevolveToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              Checked="RevolveToggle_Changed" Unchecked="RevolveToggle_Changed"/>
            </Grid>

            <!-- Rotation Speed Slider -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Rotation Speed" Foreground="#AAAAAA" FontSize="12"/>
                <TextBlock x:Name="RotationSpeedText" Text="1.0x" Foreground="#CCCCCC" HorizontalAlignment="Right" FontSize="12"/>
            </Grid>
            <Slider x:Name="RotationSpeedSlider" Minimum="0.2" Maximum="3.0" Value="1.0"
                    ValueChanged="RotationSpeedSlider_ValueChanged" Margin="0,0,0,10"/>

            <Separator Background="#3A3A3A" Margin="0,4,0,10"/>

            <!-- Override Album Color Toggle -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Override album color" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13"/>
                <ToggleButton x:Name="OverrideToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              Checked="OverrideToggle_Changed" Unchecked="OverrideToggle_Changed"/>
            </Grid>

            <!-- Color Pickers Container -->
            <Grid x:Name="ColorPickersContainer" Visibility="Collapsed" Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Primary Color -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="PrimaryLabel" Text="Primary 60%" Foreground="#888888" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Border x:Name="PrimarySwatch" Width="80" Height="80" CornerRadius="10"
                            Background="#E53935" BorderBrush="#555555" BorderThickness="2"
                            Cursor="Hand" MouseLeftButtonUp="PrimarySwatch_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>
                    </Border>
                    <Slider x:Name="PrimaryBrightnessSlider" Minimum="0" Maximum="100" Value="80"
                            Margin="0,6,0,0" ValueChanged="PrimaryBrightness_ValueChanged"/>
                </StackPanel>

                <!-- Secondary Color -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="SecondaryLabel" Text="Secondary 40%" Foreground="#888888" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Border x:Name="SecondarySwatch" Width="80" Height="80" CornerRadius="10"
                            Background="#1E88E5" BorderBrush="#555555" BorderThickness="2"
                            Cursor="Hand" MouseLeftButtonUp="SecondarySwatch_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>
                    </Border>
                    <Slider x:Name="SecondaryBrightnessSlider" Minimum="0" Maximum="100" Value="80"
                            Margin="0,6,0,0" ValueChanged="SecondaryBrightness_ValueChanged"/>
                </StackPanel>
            </Grid>

            <Separator Background="#3A3A3A" Margin="0,4,0,10"/>

            <!-- Display Selector -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Display" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13"/>
                <ComboBox x:Name="DisplayCombo" Grid.Column="1" Width="140"
                          Background="#333333" Foreground="White"
                          SelectionChanged="DisplayCombo_SelectionChanged"/>
            </Grid>

            <!-- Show in Taskbar Toggle -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Show in Taskbar" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13"/>
                <ToggleButton x:Name="TaskbarToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              Checked="TaskbarToggle_Changed" Unchecked="TaskbarToggle_Changed"/>
            </Grid>

            <!-- Start with Windows Toggle -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Start with Windows" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="13"/>
                <ToggleButton x:Name="StartWithWindowsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                              Checked="StartWithWindowsToggle_Changed" Unchecked="StartWithWindowsToggle_Changed"/>
            </Grid>

            <Separator Background="#3A3A3A" Margin="0,4,0,10"/>

            <!-- Version + Check for Updates -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Version 1.0" Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
                <Button Content="Check for Updates..." HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#888888" BorderBrush="#444444"
                        BorderThickness="1" FontSize="11" Padding="8,3" Cursor="Hand"
                        Click="CheckUpdates_Click"/>
            </Grid>

            <!-- Quit Button -->
            <Button Content="Quit Lumn" HorizontalAlignment="Left"
                    Background="Transparent" Foreground="#E57373" BorderBrush="#553333"
                    BorderThickness="1" Padding="12,6" FontSize="12" FontWeight="SemiBold"
                    Cursor="Hand" Click="Quit_Click"/>
        </StackPanel>
    </Border>
</Window>
