<Window x:Class="LmenV2.Views.FullscreenVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lmen v2 - Ambient Visualizer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Normal"
        ResizeMode="NoResize"
        Topmost="False"
        ShowInTaskbar="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- ========================================================= -->
        <!-- APPLE MINIMAL & LIQUID GLASS COMPONENT STYLES             -->
        <!-- ========================================================= -->

        <!-- Apple Live Controls Slider Thumb -->
        <Style x:Key="AppleSliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Width="14" Height="14"
                                CornerRadius="7"
                                Background="#FFFFFFFF"
                                BorderBrush="#30000000"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1.5" Opacity="0.35"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#FFF5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#FFE0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Live Controls Slider -->
        <Style x:Key="AppleSlider" TargetType="{x:Type Slider}">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="#25FFFFFF"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="#99FFFFFF"
                                                        VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AppleSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Liquid Glass Pill Button: translucent fill, specular sheen, rim light, springy content -->
        <Style x:Key="FrostedPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Glass body: casts the soft ambient shadow -->
                            <Border x:Name="fill"
                                    CornerRadius="999"
                                    Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.38"/>
                                </Border.Effect>
                            </Border>

                            <!-- Specular sheen across the top half -->
                            <Border x:Name="sheen" CornerRadius="999" IsHitTestVisible="False" Opacity="0.85">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                        <GradientStop Color="#0AFFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Rim light + content -->
                            <Border x:Name="rim"
                                    CornerRadius="999"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#59FFFFFF" Offset="0"/>
                                        <GradientStop Color="#16FFFFFF" Offset="0.55"/>
                                        <GradientStop Color="#0AFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="contentScale" ScaleX="1" ScaleY="1"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#2BFFFFFF"/>
                                <Setter TargetName="sheen" Property="Opacity" Value="1.0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="contentScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="contentScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="contentScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="contentScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#3DFFFFFF"/>
                                <Setter TargetName="sheen" Property="Opacity" Value="1.0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="contentScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="contentScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="contentScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="contentScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smooth Edged Rectangle Glass Button (Modern Rounded Rectangle, Never Oval) -->
        <Style x:Key="SmoothRectGlassButton" TargetType="Button">
            <Setter Property="Background" Value="#1CFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#32FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Glass body with subtle shadow -->
                            <Border x:Name="fill"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                                </Border.Effect>
                            </Border>

                            <!-- Specular sheen across the top half -->
                            <Border x:Name="sheen" CornerRadius="8" IsHitTestVisible="False" Opacity="0.85">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#30FFFFFF" Offset="0"/>
                                        <GradientStop Color="#0AFFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Rim light border + content -->
                            <Border x:Name="rim"
                                    CornerRadius="8"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#50FFFFFF" Offset="0"/>
                                        <GradientStop Color="#18FFFFFF" Offset="0.55"/>
                                        <GradientStop Color="#0AFFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="contentScale" ScaleX="1" ScaleY="1"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background" Value="#2BFFFFFF"/>
                                <Setter TargetName="sheen" Property="Opacity" Value="1.0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fill" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Liquid Glass Panel: luminous top edge, gradient rim, deep ambient shadow -->
        <Style x:Key="LiquidGlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4DFFFFFF" Offset="0"/>
                        <GradientStop Color="#17FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#0DFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F0161016" Offset="0"/>
                        <GradientStop Color="#E60D090C" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="42" ShadowDepth="10" Direction="270" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Floating Transport Circular Frosted Glass Button (Shuffle, Prev, Next, Repeat) - Refined & Compact -->
        <Style x:Key="TransportCircleButton" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#2DFFFFFF"/>
                                <Setter TargetName="circle" Property="BorderBrush" Value="#40FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#45FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Hero Play/Pause Button (Refined Center Circle) -->
        <Style x:Key="TransportHeroPlayButton" TargetType="Button">
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3CFFFFFF"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="27">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.32"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#42FFFFFF"/>
                                <Setter TargetName="circle" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#58FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Frosted Mini Circle Button (for ··· Options and ⚙ Settings) -->
        <Style x:Key="FrostedMiniCircleButton" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.22"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#2DFFFFFF"/>
                                <Setter TargetName="circle" Property="BorderBrush" Value="#40FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="circle" Property="Opacity" Value="0.32"/>
                                <Setter Property="Foreground" Value="#45FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume Mute Button inside Expandable Capsule -->
        <Style x:Key="VolumeMuteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle"
                                Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lyric Line Clickable Row Style (BitChord / Apple Music Style) -->
        <Style x:Key="LyricLineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="lineBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="16,6"
                                Margin="0,3"
                                RenderTransformOrigin="0.0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="lineBorder" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="lineBorder" Property="Background" Value="#22FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="lineBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.96" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="lineBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.96" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="lineBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="lineBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Frosted Close Circle Button (Red Hover Highlight) -->
        <Style x:Key="FrostedCloseCircleButton" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#D8FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.22"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#5AE81123"/>
                                <Setter TargetName="circle" Property="BorderBrush" Value="#90FF5555"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Background" Value="#77E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Circle Button (for Curated Palette & Dropper) -->
        <Style x:Key="ColorSwatchCircleButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="swatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatchBorder" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="swatchBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="swatchBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Dropper Pill Button Style (Liquid Glass with Top Specular Sheen) -->
        <Style x:Key="ColorDropperLiquidGlassButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#42FFFFFF" Offset="0"/>
                        <GradientStop Color="#18FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#0DFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#38FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fill"
                                    CornerRadius="20"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.30"/>
                                </Border.Effect>
                            </Border>
                            <!-- Top Specular Highlight Sheen -->
                            <Border CornerRadius="20" IsHitTestVisible="False" Margin="1,1,1,1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#28FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#5AFFFFFF" Offset="0"/>
                                            <GradientStop Color="#28FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#14FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="fill" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fill" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- APPLE LIQUID GLASS CONTEXT MENU & MENU ITEM STYLES        -->
        <!-- ========================================================= -->

        <Style x:Key="AppleLiquidGlassContextMenu" TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border x:Name="MenuBorder"
                                Background="#EA150E18"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="6"
                                MinWidth="220">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.55"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleLiquidGlassMenuItem" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="12,0"
                                Margin="0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding Header}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#70FFFFFF"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleLiquidGlassMenuSeparator" TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#20FFFFFF" Margin="10,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="MainRootBorder"
            Background="#0A0608"
            CornerRadius="0"
            BorderThickness="0"
            BorderBrush="#38FFFFFF"
            ClipToBounds="True">
        <Grid x:Name="MainRootGrid" Background="Transparent" ClipToBounds="True">

        <!-- ========================================================= -->
        <!-- TV AMBIENT BACKDROP: Enlarged Album Cover in Dead Space   -->
        <!-- Softly defocused so it is clearly recognizable            -->
        <!-- Subtly floating with organic false-motion camera sway     -->
        <!-- ========================================================= -->
        <Grid x:Name="TvBackdropHost" IsHitTestVisible="False" ClipToBounds="True">
            <Grid x:Name="BackdropMotionLayer" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BackdropScaleTransform" ScaleX="1.20" ScaleY="1.20"/>
                        <RotateTransform x:Name="BackdropRotateTransform" Angle="0"/>
                        <TranslateTransform x:Name="BackdropTranslateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Image x:Name="BackdropImageA"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="Linear"
                       Opacity="1.0"/>
                <Image x:Name="BackdropImageB"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="Linear"
                       Opacity="0.0"/>

                <!-- Normal Mode Ambient Motion Video Backdrop (Playing same video, blurred & enlarged) -->
                <MediaElement x:Name="TvMotionVideoBackdrop"
                              Stretch="UniformToFill"
                              IsHitTestVisible="False"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              Volume="0"
                              IsMuted="True"
                              ScrubbingEnabled="True"
                              Opacity="0.0"
                              MediaEnded="TvMotionVideoBackdrop_MediaEnded">
                    <MediaElement.Effect>
                        <BlurEffect Radius="65" KernelType="Gaussian" RenderingBias="Performance"/>
                    </MediaElement.Effect>
                </MediaElement>
            </Grid>

            <!-- TV Atmospheric Overlay -->
            <Rectangle x:Name="BackdropVignetteOverlay">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop x:Name="BackdropVignetteCenterStop" Color="#44000000" Offset="0"/>
                        <GradientStop x:Name="BackdropVignetteMidStop" Color="#85040205" Offset="0.55"/>
                        <GradientStop x:Name="BackdropVignetteOuterStop" Color="#DD080306" Offset="1.0"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ========================================================= -->
        <!-- SCREEN-EDGE REACTIVE GLOW BEAM                            -->
        <!-- Built in code (Rendering/EdgeBeam.cs) with octave stack   -->
        <!-- Zero blooming over the album cover or UI controls         -->
        <!-- ========================================================= -->
        <Grid x:Name="BeamHost" Background="{x:Null}" IsHitTestVisible="False" Panel.ZIndex="30" />

        <!-- ========================================================= -->
        <!-- TOP-RIGHT WINDOW CONTROLS: Settings, Minimize, Restore, Close -->
        <!-- Frosted Liquid Glass Button Capsule                       -->
        <!-- ========================================================= -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,18,22,0"
                Panel.ZIndex="50"
                Background="#24100A16"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="6,4">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Settings (Gear) -->
                <Button x:Name="TopGearButton"
                        Style="{StaticResource FrostedMiniCircleButton}"
                        Margin="0,0,5,0"
                        Click="GearButton_Click"
                        AutomationProperties.Name="Settings and Options"
                        ToolTip="Settings &amp; Options">
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="13"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource AppleLiquidGlassContextMenu}">
                            <MenuItem Style="{StaticResource AppleLiquidGlassMenuItem}" Header="Full Settings..." Click="Settings_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="⚙" FontSize="13" Foreground="#FFFFFF"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Style="{StaticResource AppleLiquidGlassMenuItem}" Header="Live Glow Controls" Click="ToggleGlowControls_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🎛" FontSize="13" Foreground="#FFFFFF"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Style="{StaticResource AppleLiquidGlassMenuItem}" Header="Pick Color from Screen" Click="StartColorDropper_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xEF3C;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="13" Foreground="#FFFFFF"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Style="{StaticResource AppleLiquidGlassMenuItem}" Header="Reset to Auto Colors" Click="ColorAuto_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✦" FontSize="12" Foreground="#FFFFFF"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuLyricsToggle" Style="{StaticResource AppleLiquidGlassMenuItem}" Header="Timed Lyrics" InputGestureText="L" Click="ToggleLyrics_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xEC4F;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="13" Foreground="#FFFFFF"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource AppleLiquidGlassMenuSeparator}"/>
                            <MenuItem x:Name="MenuRestoreToggle" Style="{StaticResource AppleLiquidGlassMenuItem}" Header="Restore (Windowed)" Click="ToggleRestore_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🗗" FontSize="13" Foreground="#FFFFFF"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Style="{StaticResource AppleLiquidGlassMenuItem}" Header="Desktop Overlay" InputGestureText="Esc" Click="SwitchToOverlay_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🗗" FontSize="13" Foreground="#FFFFFF"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Style="{StaticResource AppleLiquidGlassMenuItem}" Header="Exit Visualizer" Click="Close_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✕" FontSize="12" Foreground="#FF8888"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Minimize Button -->
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource FrostedMiniCircleButton}"
                        Margin="0,0,5,0"
                        Click="Minimize_Click"
                        AutomationProperties.Name="Minimize"
                        ToolTip="Minimize">
                    <TextBlock Text="&#xE921;"
                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>

                <!-- Restore / Maximize Button -->
                <Button x:Name="RestoreButton"
                        Style="{StaticResource FrostedMiniCircleButton}"
                        Margin="0,0,5,0"
                        Click="ToggleRestore_Click"
                        AutomationProperties.Name="Restore Down"
                        ToolTip="Restore Down (Windowed Mode)">
                    <TextBlock x:Name="RestoreIcon"
                               Text="&#xE923;"
                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>

                <!-- Exit / Close Button -->
                <Button x:Name="CloseButton"
                        Style="{StaticResource FrostedCloseCircleButton}"
                        Click="Close_Click"
                        AutomationProperties.Name="Close Visualizer"
                        ToolTip="Close Visualizer">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- ========================================================= -->
        <!-- MAIN CONTENT HOST: Centerpiece Player UI                  -->
        <!-- ========================================================= -->
        <Grid x:Name="VisualizerContentGrid"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <!-- Player Centerpiece Stack (Album Art & Controls) -->
            <StackPanel x:Name="CenterContentStack" HorizontalAlignment="Center" VerticalAlignment="Center" Width="450" Margin="0,0,0,12">

            <!-- 1. Hero Album Art Card: BIG (450x450), Clean Rounded Squircle, Ambient Shadow -->
            <Border x:Name="AlbumArtContainer"
                    Width="450" Height="450"
                    CornerRadius="28"
                    BorderThickness="0"
                    ClipToBounds="True"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5"
                    Cursor="Hand"
                    MouseLeftButtonDown="AlbumArtContainer_MouseLeftButtonDown"
                    PreviewMouseLeftButtonDown="AlbumArtContainer_PreviewMouseLeftButtonDown"
                    ToolTip="Double-click to expand to full screen in animated mode">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ArtScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="ArtDropShadow"
                                      Color="#000000"
                                      BlurRadius="32"
                                      ShadowDepth="8"
                                      Opacity="0.65"/>
                </Border.Effect>

                <Grid>
                    <!-- Fallback Gradient when no image -->
                    <Border x:Name="ArtFallbackBackground" Background="#240D14" IsHitTestVisible="False">
                        <TextBlock Text="🎵" FontSize="92" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.40"/>
                    </Border>
                    <!-- Motion Album Cover Video: Hardware GPU Accelerated 60fps Looping Video (Underneath cover image) -->
                    <MediaElement x:Name="AlbumCoverVideo"
                                  Stretch="UniformToFill"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  Volume="0"
                                  IsMuted="True"
                                  ScrubbingEnabled="True"
                                  Opacity="1.0"
                                  Visibility="Visible"
                                  IsHitTestVisible="False"
                                  MediaOpened="AlbumCoverVideo_MediaOpened"
                                  MediaEnded="AlbumCoverVideo_MediaEnded"
                                  MediaFailed="AlbumCoverVideo_MediaFailed"/>
                    <!-- Album Cover Image: Hardware Linear Bilinear Filtering (On top of video, shields user from video loading artifacts) -->
                    <Image x:Name="AlbumCoverImage"
                           Stretch="UniformToFill"
                           IsHitTestVisible="False"
                           Opacity="1.0"
                           RenderOptions.BitmapScalingMode="Linear"/>
                    <!-- Ambient Motion Artwork Pill Badge -->
                    <Border x:Name="MotionBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="14"
                            CornerRadius="10"
                            Background="#65000000"
                            BorderBrush="#25FFFFFF"
                            BorderThickness="1"
                            Padding="7,3.5"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            MouseLeftButtonDown="MotionBadge_MouseLeftButtonDown">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="▶" FontSize="8" Foreground="#D0FFFFFF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MOTION" FontSize="9" FontWeight="Bold" Foreground="#D0FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Track Info & Options Row: Refined Typography & Compact ··· Button -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Artist -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="TrackTitleText"
                               Text="Ready to Play"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFFFF"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,2">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1.5" Opacity="0.75"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="ArtistNameText"
                               Text="Play music to begin"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="#95FFFFFF"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.75"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Right: Motion, Lyrics, Dropper & Options Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MotionButton"
                            Margin="0,0,8,0"
                            Style="{StaticResource FrostedMiniCircleButton}"
                            Click="MotionButton_Click"
                            AutomationProperties.Name="Motion Canvas"
                            ToolTip="Fullscreen Animated Album Cover / Motion Canvas (M / Double-click)">
                        <TextBlock x:Name="MotionButtonIcon"
                                   Text="&#xE714;"
                                   FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="LyricsButton"
                            Margin="0,0,8,0"
                            Style="{StaticResource FrostedMiniCircleButton}"
                            Click="ToggleLyrics_Click"
                            AutomationProperties.Name="Timed Lyrics"
                            ToolTip="Timed Lyrics Mode (L)">
                        <TextBlock x:Name="LyricsButtonIcon"
                                   Text="&#xEC4F;"
                                   FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="DropperButton"
                            Margin="0,0,8,0"
                            Style="{StaticResource FrostedMiniCircleButton}"
                            Click="StartColorDropper_Click"
                            AutomationProperties.Name="Color Dropper"
                            ToolTip="Color Dropper: Pick any color on screen for this song">
                        <TextBlock Text="&#xEF3C;"
                                   FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MoreOptionsButton"
                            Style="{StaticResource FrostedMiniCircleButton}"
                            Click="ToggleGlowControls_Click"
                            AutomationProperties.Name="Live Glow Controls"
                            ToolTip="Live Glow Controls &amp; Visual Options">
                        <TextBlock Text="&#xE712;"
                                   FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 3. Precision Interactive Progress Scrubber (Sleek 3px track, 10px knob) -->
            <StackPanel Margin="0,14,0,0">
                <Grid x:Name="TimelineTrackContainer"
                      Height="20"
                      Cursor="Hand"
                      Background="Transparent"
                      ClipToBounds="False"
                      MouseLeftButtonDown="Timeline_MouseLeftButtonDown"
                      MouseMove="Timeline_MouseMove"
                      MouseLeftButtonUp="Timeline_MouseLeftButtonUp">

                    <!-- Background Track -->
                    <Border Height="3"
                            CornerRadius="1.5"
                            Background="#22FFFFFF"
                            VerticalAlignment="Center"/>

                    <!-- Elapsed Track Fill (Hardware Transform Driven - Zero Layout Passes) -->
                    <Border x:Name="TimelineProgressBar"
                            Height="3"
                            CornerRadius="1.5"
                            Background="#FFFFFFFF"
                            HorizontalAlignment="Left"
                            Width="1"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressBarScale" ScaleX="0.001" ScaleY="1.0"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Scrubber Thumb Knob (10x10, Hardware Transform Driven - Zero Layout Passes) -->
                    <Border x:Name="TimelineKnob"
                            Width="10" Height="10"
                            CornerRadius="5"
                            Background="#FFFFFFFF"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="KnobTranslate" X="-5" Y="0"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.45"/>
                        </Border.Effect>
                    </Border>
                </Grid>

                <!-- Timestamps: Left Elapsed, Right Remaining -->
                <DockPanel Margin="0,3,0,0">
                    <TextBlock x:Name="PositionText"
                               Text="0:00"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#70FFFFFF"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="DurationText"
                               DockPanel.Dock="Right"
                               Text="-0:00"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#70FFFFFF"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </StackPanel>

            <!-- 4. Transport Controls: Sleek & Compact 5 Circular Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,16,0,0">
                <!-- Shuffle -->
                <Button x:Name="ShuffleButton"
                        Style="{StaticResource TransportCircleButton}"
                        Margin="0,0,14,0"
                        Click="Shuffle_Click"
                        AutomationProperties.Name="Shuffle"
                        ToolTip="Shuffle">
                    <TextBlock Text="&#xE8B1;"
                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="13"/>
                </Button>

                <!-- Previous -->
                <Button x:Name="PrevButton"
                        Style="{StaticResource TransportCircleButton}"
                        Margin="0,0,16,0"
                        Click="Prev_Click"
                        AutomationProperties.Name="Previous Track"
                        ToolTip="Previous Track (Left Arrow)">
                    <TextBlock Text="&#xE892;"
                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="14"/>
                </Button>

                <!-- Hero Play / Pause (Refined 54x54) -->
                <Button x:Name="PlayPauseButton"
                        Style="{StaticResource TransportHeroPlayButton}"
                        Margin="0,0,16,0"
                        RenderTransformOrigin="0.5,0.5"
                        Click="PlayPause_Click"
                        AutomationProperties.Name="Play or Pause"
                        ToolTip="Play / Pause (Space)">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="PlayPauseScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Button.RenderTransform>
                    <Button.Effect>
                        <DropShadowEffect x:Name="PlayPauseShadow" Color="#FFFFFF" BlurRadius="18" ShadowDepth="0" Opacity="0.30"/>
                    </Button.Effect>
                    <TextBlock x:Name="PlayPauseIcon"
                               Text="&#xE769;"
                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="18"/>
                </Button>

                <!-- Next -->
                <Button x:Name="NextButton"
                        Style="{StaticResource TransportCircleButton}"
                        Margin="0,0,14,0"
                        Click="Next_Click"
                        AutomationProperties.Name="Next Track"
                        ToolTip="Next Track (Right Arrow)">
                    <TextBlock Text="&#xE893;"
                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="14"/>
                </Button>

                <!-- Repeat -->
                <Button x:Name="RepeatButton"
                        Style="{StaticResource TransportCircleButton}"
                        Click="Repeat_Click"
                        AutomationProperties.Name="Repeat"
                        ToolTip="Repeat">
                    <TextBlock Text="&#xE8EE;"
                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="13"/>
                </Button>
            </StackPanel>

            <!-- 5. Modern Liquid Glass Expandable Volume Control (Collapses to Icon, Expands on Hover) -->
            <Border x:Name="VolumeControlContainer"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,14,0,0"
                    Height="36"
                    Width="36"
                    CornerRadius="18"
                    Background="#18FFFFFF"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    ClipToBounds="True"
                    MouseEnter="VolumeControl_MouseEnter"
                    MouseLeave="VolumeControl_MouseLeave"
                    MouseWheel="VolumeControl_MouseWheel"
                    Cursor="Hand"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mute / Unmute Button (The Icon) -->
                    <Button x:Name="VolumeMuteButton"
                            Grid.Column="0"
                            Style="{StaticResource VolumeMuteButtonStyle}"
                            Click="VolumeMuteButton_Click"
                            AutomationProperties.Name="Mute or Unmute Volume"
                            ToolTip="Master Volume (Click to Mute, Hover to Expand)">
                        <TextBlock x:Name="VolumeIcon"
                                   Text="&#xE767;"
                                   FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Expanded Controls (Slider + Percentage) -->
                    <StackPanel x:Name="VolumeSliderPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Opacity="0"
                                Visibility="Collapsed"
                                Margin="2,0,12,0">
                        <!-- Volume Slider -->
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource AppleSlider}"
                                Width="140"
                                Minimum="0" Maximum="100" Value="70"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                                LostMouseCapture="VolumeSlider_LostMouseCapture"
                                MouseWheel="VolumeControl_MouseWheel"
                                AutomationProperties.Name="Master Volume"
                                ToolTip="Master Volume (Scroll or Up/Down arrows)"/>

                        <!-- Volume Percentage Text -->
                        <TextBlock x:Name="VolumePercentText"
                                   Text="70%"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#A0FFFFFF"
                                   Width="34"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. Bottom Smooth-Edged Rectangle Button: 4-Pointed Sparkle Star Icon, reveals faint 'Reactive Glow' on hover -->
            <Button x:Name="ReactiveGlowButton"
                    Style="{StaticResource SmoothRectGlassButton}"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    Height="32"
                    Padding="9,0"
                    RenderTransformOrigin="0.5,0.5"
                    Click="ToggleAudioPulse_Click"
                    MouseEnter="ReactiveGlowButton_MouseEnter"
                    MouseLeave="ReactiveGlowButton_MouseLeave"
                    AutomationProperties.Name="Toggle Reactive Glow"
                    ToolTip="Toggle dynamic reactive glow">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="ReactiveGlowScale" ScaleX="1.0" ScaleY="1.0"/>
                </Button.RenderTransform>
                <Button.Effect>
                    <DropShadowEffect x:Name="ReactiveGlowShadow"
                                      Color="#FFFFFF"
                                      BlurRadius="16"
                                      ShadowDepth="0"
                                      Opacity="0.45"/>
                </Button.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- 4-Pointed Sparkle Star (Exact 1:1 match with user reference) -->
                    <Path x:Name="ReactiveGlowIcon"
                          Data="M 12,0 Q 12,12 24,12 Q 12,12 12,24 Q 12,12 0,12 Q 12,12 12,0 Z"
                          Fill="#FFFFFFFF"
                          Stretch="Uniform"
                          Width="13" Height="13"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>

                    <!-- Faint readable text, revealed smoothly on hover -->
                    <TextBlock x:Name="ReactiveGlowText"
                               Text="Reactive Glow"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="#90FFFFFF"
                               VerticalAlignment="Center"
                               Opacity="0.0"
                               Width="0"
                               Margin="0"
                               ClipToBounds="True"/>
                </StackPanel>
            </Button>

        </StackPanel>
        </Grid>

        <!-- ========================================================= -->
        <!-- FULLSCREEN KARAOKE LYRICS STAGE                           -->
        <!-- Replaces the main player UI with centered big lyrics      -->
        <!-- Edge beam glow runs around the perimeter normally         -->
        <!-- ========================================================= -->
        <Grid x:Name="FullscreenLyricsStage"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Visibility="Collapsed">

            <!-- Top Floating Header Bar (Subtle & Minimalist) -->
            <Grid VerticalAlignment="Top" Margin="48,32,48,0" Panel.ZIndex="10">
                <!-- Track Info Pill: Title & Artist -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border BorderThickness="1"
                            CornerRadius="16"
                            Padding="16,8"
                            HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33FFFFFF" Offset="0"/>
                                <GradientStop Color="#14FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#4DFFFFFF" Offset="0"/>
                                <GradientStop Color="#12FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LyricsSongTitleText"
                                       Text="Ready to Play"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E0FFFFFF"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="•" FontSize="11" Foreground="#60FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LyricsArtistText"
                                       Text="Play music to begin"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="#85FFFFFF"/>
                        </StackPanel>
                    </Border>
                    <!-- Translation / Romanization / Source status (BitChord-style feedback line) -->
                    <TextBlock x:Name="LyricsTranslationStatusText"
                               Text=""
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#B8FFC6D8"
                               Margin="8,8,0,0"
                               HorizontalAlignment="Left"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Right Action Controls: Translate / Romanize / Offset / Style / Close -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Translate Lyrics -->
                    <Button x:Name="LyricsTranslateButton"
                            Style="{StaticResource FrostedPillButton}"
                            Padding="13,7"
                            Margin="0,0,10,0"
                            Click="LyricsTranslate_Click"
                            AutomationProperties.Name="Translate Lyrics"
                            ToolTip="Translate lyrics into the language chosen in Settings">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LyricsTranslateText" Text="Translate" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Romanize Lyrics -->
                    <Button x:Name="LyricsRomanizeButton"
                            Style="{StaticResource FrostedPillButton}"
                            Padding="13,7"
                            Margin="0,0,10,0"
                            Click="LyricsRomanize_Click"
                            AutomationProperties.Name="Romanize Lyrics"
                            ToolTip="Show non-Latin lyrics in the Latin alphabet">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Aa" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LyricsRomanizeText" Text="Romanize" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Manual Sync Offset -->
                    <Button x:Name="LyricsOffsetButton"
                            Style="{StaticResource FrostedPillButton}"
                            Padding="13,7"
                            Margin="0,0,10,0"
                            Click="LyricsOffsetButton_Click"
                            AutomationProperties.Name="Lyric Sync Offset"
                            ToolTip="Shift lyric timing to match the recording">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Offset" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Lyric Source Picker -->
                    <Button x:Name="LyricsProviderButton"
                            Style="{StaticResource FrostedPillButton}"
                            Padding="13,7"
                            Margin="0,0,10,0"
                            Click="LyricsProviderButton_Click"
                            AutomationProperties.Name="Lyric Source"
                            ToolTip="Choose where these lyrics come from">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Source" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Style Toggle: Stage (BitChord) vs Fisheye Lens (Verci) -->
                    <Button x:Name="LyricsStyleToggleButton"
                            Style="{StaticResource FrostedPillButton}"
                            Padding="13,7"
                            Margin="0,0,10,0"
                            Click="LyricsStyleToggle_Click"
                            AutomationProperties.Name="Switch Lyrics Style"
                            ToolTip="Switch Style: Stage (BitChord) / Fisheye Lens (Verci) [S]">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LyricsStyleIcon" Text="📜" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LyricsStyleText" Text="Stage View" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Exit Fullscreen Lyrics Button -->
                    <Button x:Name="ExitLyricsButton"
                            Style="{StaticResource FrostedPillButton}"
                            Padding="16,7"
                            Click="ExitLyrics_Click"
                            AutomationProperties.Name="Close Lyrics"
                            ToolTip="Return to Player (Esc / L)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Close Lyrics" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Fisheye Lens Stage (Verci Style) -->
            <Canvas x:Name="FisheyeLyricsCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ClipToBounds="True"
                    Background="Transparent"
                    Visibility="Collapsed"/>

            <!-- Center Stage: Frictionless Fullscreen Smooth Lyrics Scroller (Stage Style - BitChord exact port) -->
            <ScrollViewer x:Name="LyricsScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Focusable="False"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ScrollChanged="LyricsScrollViewer_ScrollChanged"
                          PreviewMouseWheel="LyricsScrollViewer_PreviewMouseWheel"
                          Visibility="Visible">
                <StackPanel x:Name="LyricsLinesStack"
                            HorizontalAlignment="Stretch"
                            MaxWidth="1080"
                            Margin="48,30,48,600">
                    <!-- Populated dynamically with Karaoke Lyric Line items -->
                </StackPanel>
            </ScrollViewer>

            <!-- Top & Bottom Soft Vignette Fades -->
            <Rectangle Height="140" VerticalAlignment="Top" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EE0A0608" Offset="0"/>
                        <GradientStop Color="#000A0608" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="160" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000A0608" Offset="0"/>
                        <GradientStop Color="#EE0A0608" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Status Overlay: Searching / Not Found / Instrumental -->
            <Border x:Name="LyricsStatusOverlay"
                    Background="Transparent"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LyricsStatusIcon"
                               Text="🎵"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"
                               Opacity="0.8"/>
                    <TextBlock x:Name="LyricsStatusText"
                               Text="Looking for synced lyrics..."
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="#C0FFFFFF"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Lyrics Sync Offset Popover (BitChord manual sync) -->
            <Grid x:Name="LyricsOffsetOverlay"
                  Background="#01000000"
                  Visibility="Collapsed"
                  MouseLeftButtonDown="LyricsOffsetOverlay_MouseLeftButtonDown">
                <Border Style="{StaticResource LiquidGlassPanel}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="LyricsOverlayPanel_MouseLeftButtonDown">
                    <Grid>
                        <!-- Specular sheen -->
                        <Border CornerRadius="23" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.5"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="24,18">
                        <TextBlock Text="Lyric Sync Offset"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#E8FFFFFF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Shift lyric timing without touching the track"
                                   FontSize="10.5"
                                   Foreground="#70FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,12"/>
                        <TextBlock x:Name="LyricsOffsetValueText"
                                   Text="0.0s"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource FrostedPillButton}" Content="-1.0s" Padding="12,7" Margin="0,0,8,0" Click="LyricsOffsetStep_Click" Tag="-1000" AutomationProperties.Name="Decrease lyric offset by 1 second" ToolTip="Decrease offset by 1.0s"/>
                            <Button Style="{StaticResource FrostedPillButton}" Content="-0.5s" Padding="12,7" Margin="0,0,8,0" Click="LyricsOffsetStep_Click" Tag="-500" AutomationProperties.Name="Decrease lyric offset by 0.5 seconds" ToolTip="Decrease offset by 0.5s"/>
                            <Button Style="{StaticResource FrostedPillButton}" Content="-0.1s" Padding="12,7" Margin="0,0,8,0" Click="LyricsOffsetStep_Click" Tag="-100" AutomationProperties.Name="Decrease lyric offset by 0.1 seconds" ToolTip="Decrease offset by 0.1s"/>
                            <Button Style="{StaticResource FrostedPillButton}" Content="Reset" Padding="12,7" Margin="0,0,8,0" Click="LyricsOffsetReset_Click" AutomationProperties.Name="Reset lyric offset" ToolTip="Reset offset to 0.0s"/>
                            <Button Style="{StaticResource FrostedPillButton}" Content="+0.1s" Padding="12,7" Margin="0,0,8,0" Click="LyricsOffsetStep_Click" Tag="100" AutomationProperties.Name="Increase lyric offset by 0.1 seconds" ToolTip="Increase offset by 0.1s"/>
                            <Button Style="{StaticResource FrostedPillButton}" Content="+0.5s" Padding="12,7" Margin="0,0,8,0" Click="LyricsOffsetStep_Click" Tag="500" AutomationProperties.Name="Increase lyric offset by 0.5 seconds" ToolTip="Increase offset by 0.5s"/>
                            <Button Style="{StaticResource FrostedPillButton}" Content="+1.0s" Padding="12,7" Click="LyricsOffsetStep_Click" Tag="1000" AutomationProperties.Name="Increase lyric offset by 1 second" ToolTip="Increase offset by 1.0s"/>
                        </StackPanel>
                        <TextBlock Text="Positive values show lyrics later · click outside to close"
                                   FontSize="10"
                                   Foreground="#5CFFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Lyric Source Picker (BitChord LyricsProviderSheet) -->
            <Grid x:Name="LyricsProviderOverlay"
                  Background="#01000000"
                  Visibility="Collapsed"
                  MouseLeftButtonDown="LyricsProviderOverlay_MouseLeftButtonDown">
                <Border Style="{StaticResource LiquidGlassPanel}"
                        MaxWidth="470"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="LyricsOverlayPanel_MouseLeftButtonDown">
                    <Grid>
                        <!-- Specular sheen -->
                        <Border CornerRadius="23" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.5"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="22,18">
                        <TextBlock Text="Lyric Source"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#E8FFFFFF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Fetch this song's lyrics from one specific provider"
                                   FontSize="10.5"
                                   Foreground="#70FFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,8"/>
                        <TextBlock x:Name="LyricsProviderStatusText"
                                   Text=""
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#B8FFC6D8"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"
                                   Visibility="Collapsed"/>
                        <ScrollViewer MaxHeight="400"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,4,0,0">
                            <StackPanel x:Name="LyricsProviderListPanel"/>
                        </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- "Sync to Track" Floating Pill Button -->
            <Button x:Name="SyncLyricsPillButton"
                    Style="{StaticResource FrostedPillButton}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,32"
                    Padding="18,8"
                    Visibility="Collapsed"
                    Click="SyncLyricsPillButton_Click"
                    AutomationProperties.Name="Sync to Track"
                    ToolTip="Re-sync scroll position with current song time">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Sync to Track" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ========================================================= -->
        <!-- FULLSCREEN MOTION ARTWORK CANVAS STAGE                    -->
        <!-- Full-screen animated album cover video                    -->
        <!-- Edge beam reactive glow preserved around edges            -->
        <!-- ========================================================= -->
        <Grid x:Name="FullscreenMotionStage"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="Transparent"
              Visibility="Collapsed"
              MouseMove="FullscreenMotionStage_MouseMove"
              MouseLeftButtonDown="FullscreenMotionStage_MouseLeftButtonDown"
              PreviewMouseLeftButtonDown="FullscreenMotionStage_PreviewMouseLeftButtonDown">

            <!-- TV Ambient Defocused Album Artwork in Dead Space -->
            <Image x:Name="MotionBlurredBackdrop"
                   Stretch="UniformToFill"
                   IsHitTestVisible="False"
                   Opacity="0.80"
                   RenderOptions.BitmapScalingMode="Linear"/>

            <!-- Fullscreen Ambient Motion Video Backdrop (Playing same video, blurred & enlarged) -->
            <MediaElement x:Name="MotionVideoBackdrop"
                          Stretch="UniformToFill"
                          IsHitTestVisible="False"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Volume="0"
                          IsMuted="True"
                          ScrubbingEnabled="True"
                          Opacity="0.0"
                          MediaEnded="MotionVideoBackdrop_MediaEnded">
                <MediaElement.Effect>
                    <BlurEffect Radius="65" KernelType="Gaussian" RenderingBias="Performance"/>
                </MediaElement.Effect>
            </MediaElement>

            <!-- Atmospheric Vignette Overlay over Dead Space -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#25000000" Offset="0"/>
                        <GradientStop Color="#70050207" Offset="0.55"/>
                        <GradientStop Color="#DC070308" Offset="1.0"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Main Centered Motion Artwork Frame -->
            <Border x:Name="MotionCenterFrame"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    ClipToBounds="True"
                    Margin="48,72,48,116">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="64" ShadowDepth="12" Opacity="0.80"/>
                </Border.Effect>
                <Grid>
                    <!-- Fullscreen Motion Video Element (Underneath cover image) -->
                    <MediaElement x:Name="FullscreenMotionVideo"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  Volume="0"
                                  IsMuted="True"
                                  ScrubbingEnabled="True"
                                  Opacity="1.0"
                                  IsHitTestVisible="False"
                                  MediaOpened="FullscreenMotionVideo_MediaOpened"
                                  MediaEnded="FullscreenMotionVideo_MediaEnded"
                                  MediaFailed="FullscreenMotionVideo_MediaFailed"/>

                    <!-- High-Res Static Album Cover Base (On top of video, shields user from video loading artifacts) -->
                    <Image x:Name="FullscreenCoverImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Opacity="1.0"
                           RenderOptions.BitmapScalingMode="Linear"/>
                </Grid>
            </Border>

            <!-- Top Floating Header Bar (Subtle & Minimalist, reveals on hover) -->
            <Grid x:Name="MotionHeaderBar" VerticalAlignment="Top" Margin="48,32,48,0" Panel.ZIndex="10">
                <!-- Track Info Pill: Title & Artist -->
                <Border HorizontalAlignment="Left"
                        Background="#35000000"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▶" FontSize="10" Foreground="#E0FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MotionSongTitleText"
                                   Text="Ready to Play"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#E0FFFFFF"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="•" FontSize="11" Foreground="#60FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MotionArtistText"
                                   Text="Play music to begin"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="#85FFFFFF"/>
                    </StackPanel>
                </Border>

                <!-- Exit Fullscreen Animated Cover Button -->
                <Button x:Name="ExitMotionButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource FrostedPillButton}"
                        Padding="16,7"
                        Click="ExitMotion_Click"
                        AutomationProperties.Name="Close Fullscreen Motion Artwork"
                        ToolTip="Return to Player (Esc / Double-click)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Close Fullscreen" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Bottom Subtle Hint Pill -->
            <Border x:Name="MotionHintPill"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,116"
                    Background="#30000000"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6"
                    IsHitTestVisible="False">
                <TextBlock Text="Double-click anywhere or press Esc to return"
                           FontSize="11"
                           Foreground="#80FFFFFF"/>
            </Border>

            <!-- Bottom Floating Player Control Bar (1:1 Match with Reference Design) -->
            <Border x:Name="MotionPlayerBar"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,36"
                    Height="66"
                    MinWidth="720"
                    MaxWidth="840"
                    Background="#EA120C17"
                    BorderThickness="1"
                    CornerRadius="33"
                    Padding="22,0,16,0"
                    Panel.ZIndex="20"
                    MouseLeftButtonDown="MotionPlayerBar_MouseLeftButtonDown"
                    PreviewMouseLeftButtonDown="MotionPlayerBar_PreviewMouseLeftButtonDown">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#45FFFFFF" Offset="0"/>
                        <GradientStop Color="#18FFFFFF" Offset="0.55"/>
                        <GradientStop Color="#0DFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.60"/>
                </Border.Effect>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Interactive Timeline Scrubber & Timestamps -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel VerticalAlignment="Center">
                            <!-- Track & Knob Container -->
                            <Grid x:Name="MotionTimelineTrackContainer"
                                  Height="18"
                                  Cursor="Hand"
                                  Background="Transparent"
                                  ClipToBounds="False"
                                  MouseLeftButtonDown="MotionTimeline_MouseLeftButtonDown"
                                  MouseMove="MotionTimeline_MouseMove"
                                  MouseLeftButtonUp="MotionTimeline_MouseLeftButtonUp">

                                <!-- Background Track -->
                                <Border Height="3"
                                        CornerRadius="1.5"
                                        Background="#28FFFFFF"
                                        VerticalAlignment="Center"/>

                                <!-- Elapsed Track Fill -->
                                <Border x:Name="MotionTimelineProgressBar"
                                        Height="3"
                                        CornerRadius="1.5"
                                        Background="#FFFFFFFF"
                                        HorizontalAlignment="Left"
                                        Width="1"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="MotionProgressBarScale" ScaleX="0.001" ScaleY="1.0"/>
                                    </Border.RenderTransform>
                                </Border>

                                <!-- Scrubber Knob (10x10 white pill/circle) -->
                                <Border x:Name="MotionTimelineKnob"
                                        Width="10" Height="10"
                                        CornerRadius="5"
                                        Background="#FFFFFFFF"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="MotionKnobTranslate" X="-5" Y="0"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.50"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>

                            <!-- Elapsed and Remaining Timestamps Below Track -->
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock x:Name="MotionPositionText"
                                           Text="0:00"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Left"/>
                                <TextBlock x:Name="MotionDurationText"
                                           DockPanel.Dock="Right"
                                           Text="-0:00"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Right: Transport Controls (Shuffle, Prev, Hero Play/Pause, Next, Repeat) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <!-- Shuffle -->
                        <Button x:Name="MotionShuffleButton"
                                Style="{StaticResource TransportCircleButton}"
                                Margin="0,0,12,0"
                                Click="Shuffle_Click"
                                ToolTip="Shuffle">
                            <TextBlock Text="&#xE8B1;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="13"/>
                        </Button>

                        <!-- Previous -->
                        <Button x:Name="MotionPrevButton"
                                Style="{StaticResource TransportCircleButton}"
                                Margin="0,0,14,0"
                                Click="Prev_Click"
                                ToolTip="Previous Track (Left Arrow)">
                            <TextBlock Text="&#xE892;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="14"/>
                        </Button>

                        <!-- Hero Play / Pause Button with White Halo -->
                        <Button x:Name="MotionPlayPauseButton"
                                Style="{StaticResource TransportHeroPlayButton}"
                                Width="50" Height="50"
                                Margin="0,0,14,0"
                                Click="PlayPause_Click"
                                ToolTip="Play / Pause (Space)">
                            <Button.Effect>
                                <DropShadowEffect Color="#FFFFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                            </Button.Effect>
                            <TextBlock x:Name="MotionPlayPauseIcon"
                                       Text="&#xE769;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="18"/>
                        </Button>

                        <!-- Next -->
                        <Button x:Name="MotionNextButton"
                                Style="{StaticResource TransportCircleButton}"
                                Margin="0,0,12,0"
                                Click="Next_Click"
                                ToolTip="Next Track (Right Arrow)">
                            <TextBlock Text="&#xE893;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="14"/>
                        </Button>

                        <!-- Repeat -->
                        <Button x:Name="MotionRepeatButton"
                                Style="{StaticResource TransportCircleButton}"
                                Click="Repeat_Click"
                                ToolTip="Repeat">
                            <TextBlock Text="&#xE8EE;"
                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                       FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- LIVE GLOW CONTROLS INSPECTOR (Liquid Glass Card)          -->
        <!-- ========================================================= -->
        <Border x:Name="QuickGlowControlsCard"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,48,0"
                Width="356"
                Background="#EA110C14"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                CornerRadius="22"
                Padding="20,18"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="10" Opacity="0.65"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="Live Glow Controls" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Button Content="✕" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource FrostedMiniCircleButton}"
                            Width="26" Height="26" FontSize="11" Click="CloseQuickControls_Click"
                            AutomationProperties.Name="Close Live Glow Controls"
                            ToolTip="Close Live Glow Controls"/>
                </DockPanel>

                <!-- Custom Glow Color Override & Dropper Box (Redesigned matching screenshot) -->
                <Border Margin="0,0,0,16"
                        Background="#14FFFFFF"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16,14">
                    <StackPanel>
                        <!-- Header with Dropdown Pill -->
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Glow Color" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="ColorModeBadge"
                                     DockPanel.Dock="Right"
                                     Background="#25FFFFFF"
                                     BorderBrush="#22FFFFFF"
                                     BorderThickness="1"
                                     CornerRadius="14"
                                     Padding="12,5"
                                     VerticalAlignment="Center"
                                     Cursor="Hand"
                                     MouseLeftButtonDown="ColorAuto_Click"
                                     ToolTip="Click to toggle or reset back to Auto (Album Art)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ColorModeBadgeText"
                                               Text="Auto (Album Art)"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               Foreground="#D5FFFFFF"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets, Segoe UI Symbol"
                                               FontSize="9"
                                               Foreground="#A0FFFFFF"
                                               Margin="8,1,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- 8-Column Swatches Grid matching screenshot 2 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: 8 Swatches -->
                            <!-- Col 0: Auto Swatch (with Glowing Ring & Checkmark) -->
                            <Button x:Name="ColorAutoButton"
                                    Grid.Row="0" Grid.Column="0"
                                    Width="28" Height="28"
                                    Click="ColorAuto_Click"
                                    AutomationProperties.Name="Auto Extract Color from Album Art"
                                    ToolTip="Auto: Extract from Album Art"
                                    Style="{StaticResource ColorSwatchCircleButton}"
                                    Background="#20FFFFFF"
                                    BorderBrush="#FFFFFF"
                                    BorderThickness="2">
                                <Button.Effect>
                                    <DropShadowEffect x:Name="ColorAutoGlow" Color="#FFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                                </Button.Effect>
                                <TextBlock x:Name="ColorAutoCheckmark" Text="&#x2713;" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Col 1: Cyan -->
                            <Button x:Name="SwatchCyan" Grid.Row="0" Grid.Column="1" Width="28" Height="28" Background="#00E5FF" Click="ColorSwatch_Click" AutomationProperties.Name="Cyan color" ToolTip="Cyan" Style="{StaticResource ColorSwatchCircleButton}" Tag="#00E5FF"/>
                            <!-- Col 2: Magenta / Pink -->
                            <Button x:Name="SwatchMagenta" Grid.Row="0" Grid.Column="2" Width="28" Height="28" Background="#FF007F" Click="ColorSwatch_Click" AutomationProperties.Name="Magenta Pink color" ToolTip="Magenta Pink" Style="{StaticResource ColorSwatchCircleButton}" Tag="#FF007F"/>
                            <!-- Col 3: Purple / Violet -->
                            <Button x:Name="SwatchPurple" Grid.Row="0" Grid.Column="3" Width="28" Height="28" Background="#7C4DFF" Click="ColorSwatch_Click" AutomationProperties.Name="Cyber Violet color" ToolTip="Cyber Violet" Style="{StaticResource ColorSwatchCircleButton}" Tag="#7C4DFF"/>
                            <!-- Col 4: Orange -->
                            <Button x:Name="SwatchOrange" Grid.Row="0" Grid.Column="4" Width="28" Height="28" Background="#FF6D00" Click="ColorSwatch_Click" AutomationProperties.Name="Sunset Orange color" ToolTip="Sunset Orange" Style="{StaticResource ColorSwatchCircleButton}" Tag="#FF6D00"/>
                            <!-- Col 5: Emerald Mint Green -->
                            <Button x:Name="SwatchMint" Grid.Row="0" Grid.Column="5" Width="28" Height="28" Background="#00E676" Click="ColorSwatch_Click" AutomationProperties.Name="Emerald Mint color" ToolTip="Emerald Mint" Style="{StaticResource ColorSwatchCircleButton}" Tag="#00E676"/>
                            <!-- Col 6: Blue -->
                            <Button x:Name="SwatchBlue" Grid.Row="0" Grid.Column="6" Width="28" Height="28" Background="#0077FF" Click="ColorSwatch_Click" AutomationProperties.Name="Electric Blue color" ToolTip="Electric Blue" Style="{StaticResource ColorSwatchCircleButton}" Tag="#0077FF"/>
                            <!-- Col 7: Yellow -->
                            <Button x:Name="SwatchYellow" Grid.Row="0" Grid.Column="7" Width="28" Height="28" Background="#FFD600" Click="ColorSwatch_Click" AutomationProperties.Name="Solar Gold color" ToolTip="Solar Gold" Style="{StaticResource ColorSwatchCircleButton}" Tag="#FFD600"/>

                            <!-- Row 2: 3 Swatches (Aligned under Col 0, 1, 2) -->
                            <!-- Col 0: Crimson Red -->
                            <Button x:Name="SwatchRed" Grid.Row="2" Grid.Column="0" Width="28" Height="28" Background="#FF2A55" Click="ColorSwatch_Click" AutomationProperties.Name="Crimson Red color" ToolTip="Crimson Red" Style="{StaticResource ColorSwatchCircleButton}" Tag="#FF2A55"/>
                            <!-- Col 1: Pure White -->
                            <Button x:Name="SwatchWhite" Grid.Row="2" Grid.Column="1" Width="28" Height="28" Background="#FFFFFF" Click="ColorSwatch_Click" AutomationProperties.Name="Pure White color" ToolTip="Pure White" Style="{StaticResource ColorSwatchCircleButton}" Tag="#FFFFFF"/>
                            <!-- Col 2: Dropper Icon Button -->
                            <Button x:Name="SwatchDropper" Grid.Row="2" Grid.Column="2" Width="28" Height="28" Background="#28FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" Click="MoreColors_Click" AutomationProperties.Name="Custom Color Palette" ToolTip="Custom Color Palette..." Style="{StaticResource ColorSwatchCircleButton}">
                                <TextBlock Text="&#xEF3C;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Full Width Color Dropper Pill Button -->
                        <Button x:Name="QuickDropperButton"
                                Margin="0,16,0,0"
                                Height="40"
                                Style="{StaticResource ColorDropperLiquidGlassButton}"
                                Click="StartColorDropper_Click"
                                AutomationProperties.Name="Pick Color from Screen"
                                ToolTip="Pick any color from screen">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xEF3C;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol" FontSize="13" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Color Dropper" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Subtitle -->
                        <TextBlock Text="Custom colors reset to auto when next song plays."
                                   FontSize="10.5"
                                   Foreground="#80FFFFFF"
                                   Margin="0,12,0,0"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Glow Brightness -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Glow Brightness" FontSize="12" FontWeight="Medium" Foreground="#B0FFFFFF"/>
                    <TextBlock x:Name="BrightnessValText" Text="85%" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="BrightnessSlider" Style="{StaticResource AppleSlider}" Minimum="20" Maximum="150" Value="85" Margin="0,0,0,14"
                        AutomationProperties.Name="Glow Brightness"
                        ValueChanged="BrightnessSlider_ValueChanged"/>

                <!-- Glow Spread -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Glow Spread" FontSize="12" FontWeight="Medium" Foreground="#B0FFFFFF"/>
                    <TextBlock x:Name="SpreadValText" Text="120 px" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SpreadSlider" Style="{StaticResource AppleSlider}" Minimum="50" Maximum="260" Value="120" Margin="0,0,0,14"
                        AutomationProperties.Name="Glow Spread"
                        ValueChanged="SpreadSlider_ValueChanged"/>

                <!-- TV Backdrop Brightness -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Backdrop Brightness" FontSize="12" FontWeight="Medium" Foreground="#B0FFFFFF"/>
                    <TextBlock x:Name="BackdropValText" Text="70%" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="BackdropSlider" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="100" Value="70" Margin="0,0,0,14"
                        AutomationProperties.Name="Backdrop Ambient Brightness"
                        ValueChanged="BackdropSlider_ValueChanged"/>

                <!-- Rotation Speed -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Rotation Speed" FontSize="12" FontWeight="Medium" Foreground="#B0FFFFFF"/>
                    <TextBlock x:Name="SpeedValText" Text="1.0x" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SpeedSlider" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="250" Value="100" Margin="0,0,0,14"
                        AutomationProperties.Name="Rotation Speed"
                        ValueChanged="SpeedSlider_ValueChanged"/>

                <!-- Audio Reactivity -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Music Reactivity" FontSize="12" FontWeight="Medium" Foreground="#B0FFFFFF"/>
                    <TextBlock x:Name="ReactivityValText" Text="1.0x" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="ReactivitySlider" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="200" Value="100" Margin="0,0,0,14"
                        AutomationProperties.Name="Music Reactivity"
                        ValueChanged="ReactivitySlider_ValueChanged"/>

                <!-- Master Volume -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Master Volume" FontSize="12" FontWeight="Medium" Foreground="#B0FFFFFF"/>
                    <TextBlock x:Name="QuickVolumeValText" Text="70%" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="QuickVolumeSlider" Style="{StaticResource AppleSlider}" Minimum="0" Maximum="100" Value="70" Margin="0,0,0,6"
                        AutomationProperties.Name="Master Volume"
                        ValueChanged="QuickVolumeSlider_ValueChanged"/>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- FULLSCREEN COLOR DROPPER OVERLAY                          -->
        <!-- ========================================================= -->
        <Canvas x:Name="ColorDropperOverlay"
                Background="#01000000" 
                Cursor="Cross"
                Visibility="Collapsed"
                ClipToBounds="False"
                MouseLeftButtonDown="DropperOverlay_MouseLeftButtonDown"
                MouseMove="DropperOverlay_MouseMove"
                MouseRightButtonDown="DropperOverlay_MouseRightButtonDown">

            <!-- Floating Magnifier Loupe / Color Preview Badge -->
            <Border x:Name="DropperLoupe"
                    Width="168" Height="54"
                    CornerRadius="16"
                    Background="#E615101A"
                    BorderBrush="#60FFFFFF"
                    BorderThickness="1.5"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.75"/>
                </Border.Effect>
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Circular Color Swatch -->
                    <Border x:Name="LoupeColorCircle"
                            Width="28" Height="28"
                            CornerRadius="14"
                            Background="#DC143C"
                            BorderBrush="#FFFFFFFF"
                            BorderThickness="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>

                    <!-- Color Info & Instructions -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="LoupeHexText"
                                   Text="#DC143C"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="Click to pick • Esc to cancel"
                                   FontSize="9.5"
                                   Foreground="#A0FFFFFF"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Canvas>

        <!-- Taskbar bottom hover trigger strip -->
        <Rectangle x:Name="TaskbarHoverEdge"
                   Height="4"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Stretch"
                   Fill="Transparent"
                   IsHitTestVisible="True"
                   MouseEnter="TaskbarHoverEdge_MouseEnter"
                   MouseMove="TaskbarHoverEdge_MouseMove"
                   MouseLeftButtonDown="TaskbarHoverEdge_MouseLeftButtonDown"/>

    </Grid>
    </Border>
</Window>
